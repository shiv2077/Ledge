<schemalist>
  <schema id="org.gnome.shell.extensions.ledge" path="/org/gnome/shell/extensions/ledge/">
    <key name="theme" type="s"><default>'midnight'</default><choices><choice value="midnight"/><choice value="graphite"/><choice value="nord"/><choice value="mocha"/><choice value="dracula"/><choice value="ocean"/><choice value="snow"/><choice value="frosted-dark"/><choice value="frosted-light"/><choice value="system"/><choice value="custom"/></choices><summary>Color theme</summary></key>
    <key name="custom-background" type="s"><default>'#000000'</default><summary>Custom theme rail background, #rrggbb</summary></key>
    <key name="custom-card" type="s"><default>'#1c1c1e'</default><summary>Custom theme deck background, #rrggbb</summary></key>
    <key name="custom-text" type="s"><default>'#ffffff'</default><summary>Custom theme text color, #rrggbb</summary></key>
    <key name="custom-highlight" type="s"><default>'#3584e4'</default><summary>Custom theme highlight color, #rrggbb</summary></key>
    <key name="custom-opacity" type="d"><default>1.0</default><range min="0.3" max="1.0"/><summary>Custom theme background opacity</summary></key>
    <key name="glass-blur" type="i"><default>30</default><range min="0" max="100"/><summary>Frosted glass blur radius in pixels</summary></key>
    <key name="glass-tint" type="d"><default>0.7</default><range min="0.55" max="0.95"/><summary>Frosted glass tint opacity</summary></key>
    <key name="glass-brightness" type="d"><default>0.85</default><range min="0.5" max="1.0"/><summary>Frosted glass backdrop brightness</summary></key>
    <key name="placement" type="s"><default>'panel'</default><choices><choice value="panel"/><choice value="edge"/></choices><summary>Where Ledge lives: the top bar or a screen edge</summary></key>
    <key name="panel-box" type="s"><default>'center'</default><choices><choice value="left"/><choice value="center"/><choice value="right"/></choices><summary>Top bar section that holds the chips</summary></key>
    <key name="panel-position" type="i"><default>-1</default><range min="-1" max="64"/><summary>Position in the top bar section; -1 is right after the clock in the centre, or the end of any other section</summary></key>
    <key name="panel-open-on-hover" type="b"><default>false</default><summary>Open the deck when the pointer rests on a top bar chip</summary></key>
    <key name="edge" type="s"><default>'right'</default><choices><choice value="top"/><choice value="right"/><choice value="bottom"/><choice value="left"/></choices><summary>Screen edge</summary></key>
    <key name="monitor" type="i"><default>-1</default><range min="-1" max="32"/><summary>Monitor index, or -1 for primary</summary></key>
    <key name="always-show" type="b"><default>false</default><summary>Keep the rail unfolded</summary></key>
    <key name="demo" type="b"><default>false</default><summary>Show sample readings without reading accounts</summary></key>
    <key name="claude" type="b"><default>true</default><summary>Read Claude Code usage</summary></key>
    <key name="cursor" type="b"><default>true</default><summary>Read Cursor usage</summary></key>
    <key name="codex" type="b"><default>true</default><summary>Read Codex usage</summary></key>
    <key name="power" type="b"><default>true</default><summary>Show the power profile widget</summary></key>
    <key name="todo" type="b"><default>true</default><summary>Show the todo widget</summary></key>
    <key name="models" type="b"><default>true</default><summary>Show the local models widget</summary></key>
    <key name="models-poll-seconds" type="i"><default>15</default><range min="5" max="300"/><summary>Seconds between local model checks</summary></key>
    <key name="github" type="b"><default>true</default><summary>Show the GitHub widget</summary></key>
    <key name="github-repos" type="as"><default>[]</default><summary>Repositories whose latest CI run is watched, as owner/name</summary></key>
    <key name="github-poll-seconds" type="i"><default>300</default><range min="60" max="3600"/><summary>Seconds between GitHub checks</summary></key>
    <key name="training" type="b"><default>true</default><summary>Show the training run widget</summary></key>
    <key name="training-stall-minutes" type="i"><default>10</default><range min="1" max="240"/><summary>Minutes without an update before a running job counts as stalled</summary></key>
    <key name="hidden-accounts" type="as"><default>[]</default><summary>Extra accounts hidden from the strip, by key such as claude:work</summary></key>
    <key name="usage-order" type="s"><default>'fixed'</default><choices><choice value="fixed"/><choice value="remaining"/><choice value="deficit"/></choices><summary>Order of usage chips: fixed, least remaining first, or furthest ahead of pace first</summary></key>
    <key name="headline-window" type="s"><default>'session'</default><choices><choice value="session"/><choice value="weekly"/><choice value="tightest"/></choices><summary>Which window a usage chip shows</summary></key>
    <key name="grey-when-spent" type="b"><default>true</default><summary>Grey out a usage chip whose headline window is spent</summary></key>
    <key name="reset-format" type="s"><default>'countdown'</default><choices><choice value="countdown"/><choice value="clock"/></choices><summary>Show resets as a countdown or a clock time</summary></key>
    <key name="costs" type="b"><default>true</default><summary>Estimate spend from local Claude Code and Codex transcripts</summary></key>
    <key name="alerts-muted" type="as"><default>[]</default><summary>Providers whose limit alerts are muted, by id</summary></key>
    <key name="peek-seconds" type="i"><default>5</default><range min="0" max="30"/><summary>Seconds the rail stays open on a finished or waiting session; 0 turns peek off</summary></key>
    <key name="sound-finished" type="s"><default>'complete'</default><choices><choice value="complete"/><choice value="message-new-instant"/><choice value="bell"/><choice value="dialog-information"/><choice value=""/></choices><summary>Sound theme event when a session finishes, or empty for none</summary></key>
    <key name="sound-waiting" type="s"><default>'message-new-instant'</default><choices><choice value="complete"/><choice value="message-new-instant"/><choice value="bell"/><choice value="dialog-information"/><choice value=""/></choices><summary>Sound theme event when a session needs you, or empty for none</summary></key>
    <key name="sound-preview" type="s"><default>''</default><summary>Sound theme event to play once from preferences; Ledge resets it after playing</summary></key>
    <key name="poll-seconds" type="i"><default>300</default><range min="60" max="1800"/><summary>Seconds between reads</summary></key>
    <key name="toggle-notch" type="as"><default>['&lt;Super&gt;&lt;Shift&gt;l']</default><summary>Unfold and focus Ledge, or fold it</summary></key>
  </schema>
</schemalist>
